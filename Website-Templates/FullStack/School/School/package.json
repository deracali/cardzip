{
  "name": "greenfield-college-suite",
  "private": true,
  "type": "module",
  "workspaces": ["student-app", "staff-app", "website", "admin"],
  "scripts": {
    "dev:website": "npm run dev --workspace website",
    "dev:admin": "npm run dev --workspace admin",
    "start:student": "npm run start --workspace student-app",
    "start:staff": "npm run start --workspace staff-app",
    "typecheck": "npm run typecheck:student && npm run typecheck:staff && npm run typecheck:website && npm run typecheck:admin",
    "typecheck:student": "tsc --project student-app/tsconfig.json",
    "typecheck:staff": "tsc --project staff-app/tsconfig.json",
    "typecheck:website": "tsc --project website/tsconfig.json",
    "typecheck:admin": "tsc --project admin/tsconfig.json",
    "build:web": "npm run build --workspace website && npm run build --workspace admin",
    "export:student:android": "npm run export:android --workspace student-app",
    "export:student:ios": "npm run export:ios --workspace student-app",
    "export:staff:android": "npm run export:android --workspace staff-app",
    "export:staff:ios": "npm run export:ios --workspace staff-app"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~5.9.3"
  }
}
