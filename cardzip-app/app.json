{
  "expo": {
    "name": "cardzip",
    "slug": "cardzip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cardzip-app-icon.png",
    "scheme": "realtyaistudio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/cardzip-app-icon.png",
      "bundleIdentifier": "com.ios.cardzip",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.andriod.cardzip",
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#078D45",
        "foregroundImage": "./assets/images/cardzip-app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@react-native-google-signin/google-signin/app.plugin.js",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE_WITH_REVERSED_IOS_CLIENT_ID"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/cardzip-app-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Cardzip to select gift card photos.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Cardzip to select a phone number from your contacts."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "b50d025b-7da3-4340-b39d-83db7eddd8e3"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
